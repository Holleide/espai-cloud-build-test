/* File: main/main.c */
#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/gpio.h"
#include "esp_log.h"

static const char *TAG = "blink_task";
#define BLINK_GPIO 2

/**
 * @brief LED 闪烁任务
 */
static void blinky_task(void *pvParameters) {
    ESP_LOGI(TAG, "Blinky task started on GPIO %d", BLINK_GPIO);
    
    while (1) {
        // 设置高电平
        gpio_set_level(BLINK_GPIO, 1);
        ESP_LOGD(TAG, "LED ON");
        vTaskDelay(pdMS_TO_TICKS(500));

        // 设置低电平
        gpio_set_level(BLINK_GPIO, 0);
        ESP_LOGD(TAG, "LED OFF");
        vTaskDelay(pdMS_TO_TICKS(500));
    }
}

void app_main(void) {
    ESP_LOGI(TAG, "Initializing GPIO...");

    /* 重置并配置引脚 */
    gpio_reset_pin(BLINK_GPIO);
    gpio_set_direction(BLINK_GPIO, GPIO_MODE_OUTPUT);

    /* 创建 FreeRTOS 任务 */
    xTaskCreate(
        blinky_task,           // 任务函数
        "blinky_task",         // 任务名称
        2048,                  // 栈大小 (Bytes)
        NULL,                  // 参数
        5,                     // 优先级
        NULL                   // 任务句柄
    );

    ESP_LOGI(TAG, "Task created. Main thread entering idle loop.");
    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}