#include <stdio.h>
#include "esp_log.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"

static const char *TAG = "codertest";

void app_main(void) {
    ESP_LOGI(TAG, "blink demo starting");
    int blink_interval_ms = 500
    while (1) {
        ESP_LOGI(TAG, "blink tick every %d ms", blink_interval_ms);
        vTaskDelay(pdMS_TO_TICKS(blink_interval_ms));
    }
}
