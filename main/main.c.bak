/* File: main/main.c */
#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/gpio.h"
#include "esp_log.h"

static const char *TAG = "BlinkApp";
#define BLINK_GPIO 2

/**
 * @brief LED 闪烁任务函数
 * 使用 FreeRTOS 任务实现周期性 GPIO 电平翻转
 */
static void blinky_task(void *pvParameters) {
    ESP_LOGI(TAG, "Blinky task started on GPIO %d", BLINK_GPIO);

    while (1) {
        // 设置高电平点亮/熄灭 LED（取决于电路是高电平点亮还是低电平点亮）
        gpio_set_level(BLINK_GPIO, 1);
        // vTaskDelay 使用 pdMS_TO_TICKS 将毫秒转换为 Tick 数
        vTaskDelay(pdMS_TO_TICKS(500));

        // 设置低电平
        gpio_set_level(BLINK_GPIO, 0);
        vTaskDelay(pdMS_TO_TICKS(500));
    }
}

void app_main(void) {
    ESP_LOGI(TAG, "Initializing hardware...");

    /* 1. 初始化 GPIO 引脚 */
    // 重置引脚，清除之前的配置（如输入、上拉等）
    gpio_reset_pin(BLINK_GPIO);
    // 设置为输出模式
    gpio_set_direction(BLINK_GPIO, GPIO_MODE_OUTPUT);

    /* 2. 创建 FreeRTOS 任务 */
    // 参数说明：函数指针, 任务名, 栈大小, 参数, 优先级, 句柄, 绑定核心（NULL 为自动）
    xTaskCreate(
        blinky_task,           // 任务入口函数
        "blinky_task",         // 任务描述名称
        2048,                  // 分配的栈空间 (Bytes)
        NULL,                  // 传递给任务的参数
        5,                     // 任务优先级（数字越大优先级越高）
        NULL                   // 任务句柄（此处不需要用到，设为 NULL）
    );

    ESP_LOGI(TAG, "Task created successfully. Entering idle loop.");

    /* 3. 主线程进入空闲循环 */
    while (1) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}